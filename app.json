{
  "expo": {
    "name": "Davaine",
    "slug": "davaine-bhms",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "davaine-bhms",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#F9F7F0",
    "primaryColor": "#8A9900",
    "ios": {
      "icon": "./assets/images/icon.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F9F7F0",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.davainebhms"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png",
      "name": "Davaine",
      "shortName": "Davaine",
      "themeColor": "#8A9900",
      "backgroundColor": "#F9F7F0",
      "description": "Davaine Boarding House in Toril, Davao City."
    },
    "plugins": [
      "expo-router",
      "./plugins/withShortAndroidCxxPaths",
      "./plugins/withAndroidLocalProperties",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F9F7F0",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/android-icon-monochrome.png",
          "color": "#8A9900",
          "defaultChannel": "davaine-alerts-v2",
          "enableBackgroundRemoteNotifications": false
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow Davaine to use Face ID to sign you in securely."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Davaine to access your photos so you can upload room and carousel images."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
